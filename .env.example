# Copy to .env.local for development. Never commit real values.

# Database URLs for decoupled databases
COACH_DATABASE_URL=postgres://slaa_app:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres_coach
ATHLETE_DATABASE_URL=postgres://slaa_app:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres_athlete

# Supabase Postgres via the transaction pooler (port 6543) - fallback / unified DB
DATABASE_URL=postgres://slaa_app:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Auth (admin magic-link login only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Cloudflare Turnstile. These are Cloudflare's always-pass TEST keys; replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random 32+ character string; signs the short-lived search cookie and salts IP hashes
SESSION_SECRET=

CONSENT_VERSION=2026-10-v1
# Public site URL, used in the QR code and coach invite messages
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Per-IP requests per minute. Many people at the stadium may share one mobile
# carrier IP (CGNAT); raise these on meet day if people see "Too many requests".
RATE_LIMIT_IDENTITY=10
RATE_LIMIT_SEARCH=10
RATE_LIMIT_REGISTER=10

# Development only: skip the magic link and treat this email as a signed-in admin.
# Ignored unless NODE_ENV=development.
DEV_ADMIN_EMAIL=

# M7 (after the meet)
RESEND_API_KEY=
SMS_API_KEY=
