# Copy to .env.local for development. Never commit real values.

# ─── Database (Neon PostgreSQL) ───────────────────────────
# Pooled connection (runtime queries – PgBouncer, port 5432)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct/unpooled connection (migrations & DDL only)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-XXXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Max connections per serverless instance (keep low on Vercel)
DB_POOL_MAX=3

# ─── Staff authentication (managed in the existing Neon database) ───
# Separate random 32+ character secret for admin JWTs; never expose publicly.
ADMIN_JWT_SECRET=
ADMIN_OWNER_EMAIL=ceo@ascendit.dev
# Local bootstrap/recovery only. Generated if blank; NEVER upload to Vercel.
ADMIN_INITIAL_PASSWORD=

# ─── Cloudflare Turnstile (bot protection) ────────────────
# Always-pass TEST keys for local development; replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Session / Security ──────────────────────────────────
# Random 32+ character string; signs the short-lived search cookie & salts IP hashes
SESSION_SECRET=

# ─── App Config ───────────────────────────────────────────
CONSENT_VERSION=2026-10-v1
# IMPORTANT: set to your Vercel production URL in Vercel env vars!
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Rate Limiting (per-IP requests per minute) ──────────
# Venue/carrier allowance for 500 applicants sharing one IP; CAPTCHA is required.
RATE_LIMIT_IDENTITY=600
RATE_LIMIT_SEARCH=6000
RATE_LIMIT_REGISTER=600
# Coach search has an additional per-browser limit after a successful CAPTCHA.
RATE_LIMIT_SEARCH_SESSION=60

# ─── Development Shortcuts ───────────────────────────────
# Treat this email as the signed-in owner (NODE_ENV=development only)
DEV_ADMIN_EMAIL=

# ─── Future Services (M7+) ───────────────────────────────
RESEND_API_KEY=
SMS_API_KEY=
